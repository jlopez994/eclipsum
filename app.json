{
  "expo": {
    "name": "eclipsum",
    "slug": "eclipsum",
    "version": "b41-beta",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B10",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jlopez.eclipsum",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 41,
      "permissions": [
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/eclipse.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Eclipsum usa la cámara para dibujar sobre lo que ves dónde estará el sol durante el eclipse.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Eclipsum usa los sensores de movimiento para saber hacia dónde apuntas el móvil."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "packagingOptions": {
              "exclude": [
                "**/libbarhopper_v3.so"
              ]
            },
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable\n-renamesourcefileattribute SourceFile\n"
          }
        }
      ]
    ]
  }
}
